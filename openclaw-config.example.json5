{
  plugins: {
    entries: {
      docwen: {
        enabled: true,
        config: {
          binaryPath: "C:\\Program Files\\DocWen\\DocWenCLI.exe",
          language: "zh_CN",
          readTimeoutMs: 30000,
          writeTimeoutMs: 600000,
        },
      },
    },
  },
  tools: {
    // The six write tools are optional and must be explicitly allowed.
    allow: ["docwen"],
  },
}
