{
  plugins: {
    entries: {
      docwen: {
        enabled: true,
        config: {
          binaryPath: "C:\\Program Files\\DocWen\\DocWenCLI.exe",
          language: "zh_CN",
          readTimeoutMs: 30000,
          writeTimeoutMs: 600000,
        },
      },
    },
  },
  tools: {
    // Start read-only. Add individual write tools when they are authorized.
    allow: ["docwen_info", "docwen_inspect", "docwen_resources", "docwen_validate_markdown"],
  },
}
