{
  "name": "@zhyx91/openclaw-docwen",
  "version": "3.1.1",
  "description": "Check and convert local documents, combine files, and split PDFs with DocWen in OpenClaw.",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "native/linux-x64.node",
    "native/linux-owner-x64",
    "native/windows-x64.exe",
    "native/README.md",
    "openclaw.plugin.json",
    "openclaw-config.example.json5",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2 <2027.0.0",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.9.9",
      "pluginSdkVersion": "2026.9.9"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/run-check.mjs build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary",
    "lint": "eslint src scripts",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,json5,md,mjs,ts}\" \"docs/**/*.md\" \"skills/**/*.md\" \".github/**/*.yml\"",
    "audit:prod": "node scripts/run-check.mjs audit",
    "audit:all": "node scripts/run-check.mjs audit-all",
    "package:check": "node scripts/check-package.mjs",
    "acceptance:docwen-package": "node scripts/run-docwen-package-acceptance.mjs",
    "release:build": "node scripts/build-release.mjs",
    "check": "node scripts/run-check.mjs",
    "prepack": "node scripts/run-check.mjs",
    "check:source": "node scripts/run-check.mjs source"
  },
  "dependencies": {
    "typebox": "1.3.8"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2 <2027.0.0"
  },
  "overrides": {
    "openclaw@2026.9.9": {
      "npm": "11.21.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "eslint": "10.8.0",
    "openclaw": "2026.10.5",
    "prettier": "3.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.11"
  }
}
