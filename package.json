{
  "name": "@zhyx91/openclaw-docwen",
  "version": "3.0.0",
  "description": "OpenClaw tools for DocWen Machine Protocol v2 and Artifact Bundles.",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "native/linux-x64.node",
    "native/README.md",
    "openclaw.plugin.json",
    "openclaw-config.example.json5",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2 <2027.0.0",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary",
    "lint": "eslint src scripts",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,json5,md,mjs,ts}\" \"docs/**/*.md\" \"skills/**/*.md\" \".github/**/*.yml\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "package:check": "node scripts/check-package.mjs",
    "acceptance:docwen-package": "node scripts/run-docwen-package-acceptance.mjs",
    "release:build": "node scripts/build-release.mjs",
    "check": "npm run check:source && npm run build && npm run package:check",
    "prepack": "npm run check",
    "check:source": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run audit:prod"
  },
  "dependencies": {
    "typebox": "1.3.8"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2 <2027.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "3.2.4",
    "ajv": "8.20.0",
    "eslint": "10.8.0",
    "openclaw": "2026.7.1-2",
    "prettier": "3.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^3.2.4"
  }
}
